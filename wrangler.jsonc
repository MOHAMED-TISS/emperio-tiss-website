{
  "$schema": "https://developers.cloudflare.com/workers/configuration/schema.json",
  "name": "emperio-tiss-website",
  "main": "./src/seo-worker.js",
  "compatibility_date": "2026-08-15",
  "d1_databases": [
    {
      "binding": "NEWS_DB",
      "database_name": "emperio-tiss-news",
      "database_id": "3a5e5b55-15f5-4763-a9d9-da8875f6a758",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/about/",
      "/products/",
      "/products/seafood/",
      "/products/seafood/fish/",
      "/products/seafood/shellfish/",
      "/products/seafood/cephalopods/",
      "/products/fruits-vegetables/",
      "/products/fruits/",
      "/products/vegetables/",
      "/products/seasonal/",
      "/markets/",
      "/news/",
      "/contact/",
      "/en/",
      "/en/about/",
      "/en/products/",
      "/en/products/seafood/",
      "/en/products/seafood/fish/",
      "/en/products/seafood/shellfish/",
      "/en/products/seafood/cephalopods/",
      "/en/products/fruits-vegetables/",
      "/en/products/fruits/",
      "/en/products/vegetables/",
      "/en/products/seasonal/",
      "/en/markets/",
      "/en/news/",
      "/en/contact/",
      "/fr/",
      "/fr/about/",
      "/fr/products/",
      "/fr/products/seafood/",
      "/fr/products/seafood/fish/",
      "/fr/products/seafood/shellfish/",
      "/fr/products/seafood/cephalopods/",
      "/fr/products/fruits-vegetables/",
      "/fr/products/fruits/",
      "/fr/products/vegetables/",
      "/fr/products/seasonal/",
      "/fr/markets/",
      "/fr/news/",
      "/fr/contact/",
      "/it/",
      "/it/about/",
      "/it/products/",
      "/it/products/seafood/",
      "/it/products/seafood/fish/",
      "/it/products/seafood/shellfish/",
      "/it/products/seafood/cephalopods/",
      "/it/products/fruits-vegetables/",
      "/it/products/fruits/",
      "/it/products/vegetables/",
      "/it/products/seasonal/",
      "/it/markets/",
      "/it/news/",
      "/it/contact/",
      "/ar/",
      "/ar/about/",
      "/ar/products/",
      "/ar/products/seafood/",
      "/ar/products/seafood/fish/",
      "/ar/products/seafood/shellfish/",
      "/ar/products/seafood/cephalopods/",
      "/ar/products/fruits-vegetables/",
      "/ar/products/fruits/",
      "/ar/products/vegetables/",
      "/ar/products/seasonal/",
      "/ar/markets/",
      "/ar/news/",
      "/ar/contact/"
    ],
    "html_handling": "force-trailing-slash"
  }
}
